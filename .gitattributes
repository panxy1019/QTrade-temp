# Research archive checksums must survive Windows checkout and Git export.
* text=auto eol=lf
*.parquet -text
*.jpg -text
*.png -text
*.zip -text
# Evidence manifests refer to captured file bytes; retain their original newlines.
docs/evidence/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Native JUnit failure traces retain original newlines and assertion whitespace.
docs/evidence/*.xml -text whitespace=-blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
