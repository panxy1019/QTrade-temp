{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm --prefix web ci && npm --prefix web run build:vercel",
  "outputDirectory": "web/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "excludeFiles": "{{tests,scripts,docs,plans,runtime,build,web,.venv,.vercel,_uv,.mypy_cache,.pytest_cache,.ruff_cache}/**,**/pyarrow/{tests/**,include/**,src/**,*flight*}}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api?route=/:path*"
    }
  ]
}
